{
  "name": "markdown-plantuml-viewer",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "vite preview",
    "webview2:dev": "dotnet run --project webview2 -r win-x64 -- --dev",
    "webview2:build": "npm run build && dotnet publish webview2 -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o dist/webview2"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "jszip": "^3.10.1",
    "marked": "^15.0.7",
    "mermaid": "^11.14.0",
    "plantuml-encoder": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}