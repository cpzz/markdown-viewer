{
  "name": "markdown-viewer",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "app:build": "dotnet publish webview2 -c Release -r win-x64 -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -o dist/MarkdownViewer",
    "win": "tsc && vite --config vite.config.electron.ts",
    "server": "vite preview"
  },
  "dependencies": {
    "@plantuml/core": "^1.2026.7",
    "dompurify": "^3.2.4",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "marked": "^15.0.7",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
